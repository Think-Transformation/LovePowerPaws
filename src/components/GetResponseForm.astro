---
import GetResponseSignupForm from './GetResponseSignupForm.astro';

interface Props {
	id?: string;
	heading?: string;
	description?: string;
	submitLabel?: string;
	thankYouPath?: string;
	showBorder?: boolean;
	formIdSuffix?: string;
}

const {
	id = 'subscribe',
	heading = 'Get booth updates',
	description = 'Join the mailing list for occasional updates — new designs, booth favorites, and what we’re featuring at #6113.',
	submitLabel = 'Subscribe',
	thankYouPath = '/thanks/',
	showBorder = true,
	formIdSuffix = '',
} = Astro.props;

const sectionClass = showBorder
	? 'scroll-mt-28 border-t border-lp-mint-strong/90 bg-lp-mint/35 py-16 sm:py-20'
	: 'py-0';
---

<section id={id} class={sectionClass}>
	<div class="mx-auto max-w-6xl px-4 sm:px-6">
		<div class="grid gap-10 lg:grid-cols-2 lg:gap-16 lg:items-start">
			<div>
				<h2 class="font-display text-3xl font-semibold tracking-tight text-lp-ink sm:text-4xl">
					{heading}
				</h2>
				<p class="mt-3 text-lp-slate">
					{description}
				</p>
			</div>

			<GetResponseSignupForm {submitLabel} {thankYouPath} formIdSuffix={formIdSuffix} />
		</div>
	</div>
</section>
